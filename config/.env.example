# Copy this file to config/.env (or backend/.env) and fill in the values you need.
# Default provider is Gemini -- paste YOUR OWN key below (get one at
# https://aistudio.google.com/apikey). This file is git-ignored (see
# .gitignore), so your key never gets committed -- but double check with
# `git status` before your first commit that it's actually being ignored.

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Translation provider ---
# One of: gemini | gemini_live | local | mock | openai | azure | google
TRANSLATION_PROVIDER=gemini

# Gemini (used when TRANSLATION_PROVIDER=gemini) -- paste your key here.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Step 6 (text-to-speech) -- see the comment above these in config/settings.py
# if either needs to change.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# Gemini Live Translate (used when TRANSLATION_PROVIDER=gemini_live) --
# a persistent streaming connection instead of the request/response
# Interactions API above. Reuses GEMINI_API_KEY (no separate credential).
# See "Using Gemini Live Translate" in README.md before trying this one --
# it auto-detects the spoken language (no source-language control) and has
# a few other v1 limitations worth knowing about first.
# GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_LIVE_FINALIZE_SILENCE_MS=700.0
# GEMINI_LIVE_MAX_PHRASE_SECONDS=15.0

# Local provider (faster-whisper + NLLB-200) -- no keys needed, just uncomment
# to override the defaults in config/settings.py.
# LOCAL_WHISPER_MODEL_SIZE=base
# LOCAL_WHISPER_COMPUTE_TYPE=int8
# LOCAL_NLLB_MODEL_REPO=entai2965/nllb-200-distilled-600M-ctranslate2
# LOCAL_NLLB_TOKENIZER_REPO=facebook/nllb-200-distilled-600M
# LOCAL_NLLB_COMPUTE_TYPE=int8

# OpenAI (used when TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=

# Azure Speech Translation (used when TRANSLATION_PROVIDER=azure) -- get a
# key from an Azure AI Speech resource (Azure AI Foundry -> Speech, or the
# standalone "Speech" resource type in the Azure portal).
AZURE_SPEECH_KEY=
# The short region code, NOT a full URL -- e.g. from an endpoint like
# https://eastus2.stt.speech.microsoft.com, the region is "eastus2".
AZURE_SPEECH_REGION=

# Google Cloud (used when TRANSLATION_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# --- Voice Activity Detection (VAD) ---
# Audio is split into phrases by detected speech, not fixed time windows --
# see backend/audio/segmenter.py. Defaults are usually fine; tune if VAD
# feels too trigger-happy on background noise (raise VAD_THRESHOLD) or cuts
# phrases too eagerly/late (adjust VAD_END_SILENCE_MS, 400-700ms typical).
# VAD_THRESHOLD=0.01
# VAD_PRE_SPEECH_MS=400.0
# VAD_END_SILENCE_MS=500.0
# VAD_PARTIAL_INTERVAL_MS=700.0

# --- Streaming translation (Phase 8) ---
# Translate/speak the stable part of a growing partial transcript before
# the whole sentence is done -- see "Using streaming translation" in
# README.md. Only takes effect for TRANSLATION_PROVIDER=gemini or mock
# (local/azure are unaffected regardless of this setting). Defaults are a
# reasonable starting point; tune from your own backend logs.
# STREAMING_INCREMENTAL_TRANSLATION=true
# STREAMING_STABILITY_HOLDBACK_WORDS=2
# STREAMING_MIN_COMMIT_WORDS=3
# STREAMING_FINAL_RECONCILE_MIN_COVERAGE=0.9

# --- Logging ---
LOG_LEVEL=INFO

# --- Debugging / testing ---
# Set this to record every session's raw incoming mic audio to a .wav file
# in this directory, so you can literally play back what the backend
# received (see "Testing the microphone pipeline" in README.md).
# DEBUG_AUDIO_DUMP_DIR=./debug_audio
