# Copy this file to config/.env (or backend/.env) and fill in the values you need.
# The app runs with zero configuration using TRANSLATION_PROVIDER=mock.

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Translation provider ---
# One of: mock | openai | azure | google
TRANSLATION_PROVIDER=mock

# OpenAI (used when TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=

# Azure Speech Translation (used when TRANSLATION_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud (used when TRANSLATION_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=2.0

# --- Logging ---
LOG_LEVEL=INFO
