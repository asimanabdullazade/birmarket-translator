# Copy this file to bot/.env (git-ignored) and fill in real values, or
# pass these as `docker run -e VAR=value` / `--env-file bot/.env`.
# See bot/config.py for full docs on each field.

# Required -- the Teams "join on the web" guest link for the meeting.
TEAMS_JOIN_URL=

# Must match the meeting_id listeners use, e.g. listener.html?meeting_id=dev-meeting
MEETING_ID=dev-meeting

# If the backend runs outside Docker on your Mac while this bot runs in a
# container, use ws://host.docker.internal:8000 instead of localhost --
# "localhost" inside the container means the container itself.
BACKEND_WS_BASE=ws://localhost:8000

BOT_DISPLAY_NAME=Translation Bot

JOIN_TIMEOUT_S=60
LOBBY_TIMEOUT_S=240
MEETING_END_POLL_INTERVAL_S=5

SCREENSHOT_DIR=/var/log/bot/screenshots
LOG_LEVEL=INFO

PULSE_SINK_NAME=meetingsink
AUDIO_SAMPLE_RATE=16000
FRAME_MS=200
